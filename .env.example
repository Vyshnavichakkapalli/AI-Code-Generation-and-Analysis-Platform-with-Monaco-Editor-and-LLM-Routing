# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=codeai
DB_PORT=5432

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Groq (free, fast) — Get key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# OpenAI (reasoning model) — Get key at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REASONING_MODEL=gpt-4o-mini

# Google Gemini (fallback reasoning) — Get key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_REASONING_MODEL=gemini-2.0-flash

# ─── Routing Configuration ────────────────────────────────────────────────────
# Which provider to use for fast generation tasks: 'groq' | 'gemini'
FAST_PROVIDER=groq
# Which provider to use for reasoning tasks: 'openai' | 'gemini' | 'groq'
REASONING_PROVIDER=openai

# ─── App Configuration ────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
LLM_TIMEOUT=60
DEBUG=false
